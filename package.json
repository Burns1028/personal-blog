{
  "name": "burns-personal-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "assets:cutouts": "node scripts/build-artifact-cutouts.mjs",
    "assets:home": "node scripts/build-home-assets.mjs",
    "assets:home:orrery": "node scripts/build-home-orrery-assets.mjs",
    "assets:navigation": "node scripts/build-navigation-celestial-assets.mjs",
    "assets:projects": "node scripts/build-project-assets.mjs",
    "assets:writing": "node scripts/build-writing-assets.mjs",
    "article:upload": "node skills/burns-upload-article/scripts/upload.mjs",
    "idea:upload": "node skills/burns-upload-idea/scripts/upload.mjs",
    "github:project": "node skills/burns-update-github-progress/scripts/register-project.mjs",
    "github:progress": "node skills/burns-update-github-progress/scripts/upload.mjs",
    "test:assets": "node --test tests/archive-assets.test.ts",
    "test:content": "node --test tests/*.test.ts",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/node": "^11.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "katex": "^0.18.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
