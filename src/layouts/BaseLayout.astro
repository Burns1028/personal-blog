---
import { nav, site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "night" | "ochre" | "paper" | "document" | "code" | "stone";
}

const {
  title,
  description = site.description,
  theme = "night",
} = Astro.props;
const isLight = theme === "ochre" || theme === "paper" || theme === "stone";
const themeColor = {
  night: "#171713",
  ochre: "#d2a44b",
  paper: "#e9e0cf",
  document: "#171713",
  code: "#0d1117",
  stone: "#d8d6ce",
}[theme];
const pageTitle = title ? `${title} — ${site.shortTitle}` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isCurrentRoute = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html
  lang="zh-CN"
  class:list={[`theme-${theme}`, { "paper-page": isLight }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`theme-${theme}`, { "is-paper": isLight }]} data-route={path}>
    <a class="skip-link" href="#content">跳到正文</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${site.title} 首页`}>
        <pre class="wordmark__ascii" aria-hidden="true">{`    ____
   / __ )__  ___________  _____
  / __  / / / / ___/ __ \\/ ___/
 / /_/ / /_/ / /  / / / (__  )
/_____/\\__,_/_/  /_/ /_/____/`}</pre>
      </a>

      <nav class="site-nav" aria-label="主导航">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrentRoute(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="header-code-link" href={site.github} target="_blank" rel="noreferrer">
        GITHUB
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © 2026{" "}
        <a href="/">{site.shortTitle}</a>
        {" · Powered by "}
        <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>
      </p>
    </footer>
  </body>
</html>
