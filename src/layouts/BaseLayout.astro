---
import { nav, site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "night" | "ochre" | "paper" | "document" | "code" | "stone";
}

const {
  title,
  description = site.description,
  theme = "night",
} = Astro.props;
const isLight = theme === "ochre" || theme === "paper" || theme === "stone";
const themeColor = {
  night: "#171713",
  ochre: "#d2a44b",
  paper: "#e9e0cf",
  document: "#171713",
  code: "#0d1117",
  stone: "#d8d6ce",
}[theme];
const pageTitle = title ? `${title} — ${site.shortTitle}` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isCurrentRoute = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html
  lang="zh-CN"
  class:list={[`theme-${theme}`, { "paper-page": isLight }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");

      try {
        const journey = JSON.parse(
          sessionStorage.getItem("burns:journey") ?? "null",
        );
        if (
          journey?.to === window.location.pathname &&
          Date.now() - journey.at < 10000
        ) {
          const root = document.documentElement;
          root.dataset.journeyEntry = "true";
          history.scrollRestoration = "manual";

          const resetJourneyScroll = () => window.scrollTo(0, 0);
          const absorbArrivalScroll = (event) => event.preventDefault();
          const absorbArrivalKey = (event) => {
            if (
              [" ", "ArrowDown", "PageDown", "End"].includes(event.key)
            ) {
              event.preventDefault();
            }
          };
          let released = false;
          const releaseJourneyArrival = () => {
            if (released) return;
            released = true;
            resetJourneyScroll();
            window.removeEventListener("wheel", absorbArrivalScroll);
            window.removeEventListener("touchmove", absorbArrivalScroll);
            window.removeEventListener("keydown", absorbArrivalKey);
            delete root.dataset.journeyEntry;
            history.scrollRestoration = "auto";
            sessionStorage.removeItem("burns:journey");
            requestAnimationFrame(resetJourneyScroll);
          };

          window.addEventListener("wheel", absorbArrivalScroll, {
            passive: false,
          });
          window.addEventListener("touchmove", absorbArrivalScroll, {
            passive: false,
          });
          window.addEventListener("keydown", absorbArrivalKey);

          resetJourneyScroll();
          document.addEventListener("DOMContentLoaded", resetJourneyScroll, {
            once: true,
          });
          window.addEventListener(
            "load",
            () => window.setTimeout(releaseJourneyArrival, 1100),
            { once: true },
          );
          window.setTimeout(releaseJourneyArrival, 2600);
        }
      } catch {
        sessionStorage.removeItem("burns:journey");
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`theme-${theme}`, { "is-paper": isLight }]} data-route={path}>
    <a class="skip-link" href="#content">跳到正文</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${site.title} 首页`}>
        <pre class="wordmark__ascii" aria-hidden="true">{`    ____
   / __ )__  ___________  _____
  / __  / / / / ___/ __ \\/ ___/
 / /_/ / /_/ / /  / / / (__  )
/_____/\\__,_/_/  /_/ /_/____/`}</pre>
      </a>

      <nav class="site-nav" aria-label="主导航">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrentRoute(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="header-code-link" href={site.github} target="_blank" rel="noreferrer">
        GITHUB
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__statement">
        <span class="eyebrow">站点说明</span>
        <p>把复杂系统讲明白。<br />也让尚未完成的思考保持可见。</p>
      </div>
      <div class="site-footer__links">
        <a href={site.github} target="_blank" rel="noreferrer">GITHUB ↗</a>
        <a href="/rss.xml">RSS ↗</a>
      </div>
      <div class="site-footer__meta">
        <span>© 2026</span>
      </div>
    </footer>
  </body>
</html>
