---
import { nav, site } from "../data/site";
import "../styles/global.css";
import "../styles/home-orrery.css";
import "katex/dist/katex.min.css";

interface Props {
  title?: string;
  description?: string;
  theme?: "night" | "ochre" | "paper" | "document" | "code" | "stone";
}

const {
  title,
  description = site.description,
  theme = "night",
} = Astro.props;
const isLight = theme === "ochre" || theme === "paper" || theme === "stone";
const themeColor = {
  night: "#171713",
  ochre: "#d2a44b",
  paper: "#e9e0cf",
  document: "#171713",
  code: "#0d1117",
  stone: "#d8d6ce",
}[theme];
const pageTitle = title ? `${title} — ${site.shortTitle}` : site.title;
const path =
  Astro.url.pathname === "/"
    ? "/"
    : Astro.url.pathname.replace(/\/+$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const isCurrentRoute = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const artifactForRoute: Record<string, "document" | "repo" | "idea"> = {
  "/writing": "document",
  "/projects": "repo",
  "/ideas": "idea",
};
---

<!doctype html>
<html
  lang="zh-CN"
  class:list={[`theme-${theme}`, { "paper-page": isLight }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link
      rel="icon"
      type="image/webp"
      sizes="96x96"
      href="/assets/home-icons/ai-horizon.webp"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");

      try {
        const artifactArrival = sessionStorage.getItem(
          "burns:artifact-transition",
        );

        if (["repo", "document", "idea"].includes(artifactArrival ?? "")) {
          document.documentElement.dataset.artifactArrival = artifactArrival;
        }

        sessionStorage.removeItem("burns:artifact-transition");
      } catch {
        // Navigation remains fully functional when sessionStorage is blocked.
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`theme-${theme}`, { "is-paper": isLight }]} data-route={path}>
    <a class="skip-link" href="#content">跳到正文</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${site.title} 首页`}>
        <span class="wordmark__text">Burns</span>
      </a>

      <nav class="site-nav" aria-label="主导航">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrentRoute(item.href) ? "page" : undefined}
              data-artifact={artifactForRoute[item.href]}
            >
              <span
                class:list={[
                  "site-nav__celestial",
                  `site-nav__celestial--${item.celestial.kind}`,
                ]}
                aria-hidden="true"
              >
                <img
                  src={item.celestial.src}
                  srcset={item.celestial.srcset}
                  width={item.celestial.width}
                  height={item.celestial.height}
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              </span>
              <span class="site-nav__label">{item.label}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © 2026{" "}
        <a href="/">{site.shortTitle}</a>
        {" · Powered by "}
        <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>
      </p>
    </footer>

    <script is:inline>
        (() => {
          const root = document.documentElement;
          let settled = false;
          let pageRevealSeen = false;

        const settlePage = () => {
          if (settled) return;
          settled = true;
          root.dataset.pageSettled = "true";
          delete root.dataset.artifactArrival;
          document.dispatchEvent(new CustomEvent("burns:page-settled"));
        };

          const settleWhenIdle = () => {
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(settlePage, { timeout: 1000 });
            return;
          }

          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(settlePage);
            });
          };

          const settleAfterLoad = () => {
            if (!pageRevealSeen) {
              if (root.dataset.artifactArrival) {
                window.setTimeout(settlePage, 700);
              } else {
                settleWhenIdle();
              }
            }
          };

          window.addEventListener("load", settleAfterLoad, { once: true });
          if (document.readyState === "complete") {
            settleAfterLoad();
          }

          if ("onpagereveal" in window) {
            window.addEventListener(
              "pagereveal",
              (event) => {
                pageRevealSeen = true;
                if (event.viewTransition) {
                event.viewTransition.finished.then(settlePage, settlePage);
              } else {
                settleWhenIdle();
              }
            },
            { once: true },
          );
        } else {
          settleWhenIdle();
        }
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stage = document.querySelector(
          "[data-artifact-stage], [data-route-artifacts]",
        );
        if (!stage) return;

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        const routeLinks = document.querySelectorAll(
          "a[data-route-artifact], a[data-artifact]",
        );
        let navigating = false;

        routeLinks.forEach((link) => {
          link.addEventListener("click", (event) => {
            if (
              navigating ||
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            const anchor = event.currentTarget;
            if (!(anchor instanceof HTMLAnchorElement)) return;

            const kind =
              anchor.dataset.routeArtifact ?? anchor.dataset.artifact;
            if (!kind) return;

            sessionStorage.setItem("burns:last-artifact", kind);

            if (reduceMotion.matches) return;

            event.preventDefault();
            navigating = true;
            root.dataset.artifactIntent = kind;
            root.dataset.artifactNavigating = "true";
            sessionStorage.setItem("burns:artifact-transition", kind);
            document.dispatchEvent(
              new CustomEvent("burns:artifact-navigation-start", {
                detail: { kind },
              }),
            );

            window.requestAnimationFrame(() => {
              window.location.assign(anchor.href);
            });
          });
        });
      })();
    </script>
  </body>
</html>
