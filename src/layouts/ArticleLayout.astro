---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  summary: string;
  number: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  headings: Heading[];
  kind: "思考" | "文档" | "项目";
  readingTime?: string;
  status?: string;
  backHref: string;
}

const {
  title,
  summary,
  number,
  publishedAt,
  updatedAt,
  tags,
  headings,
  kind,
  readingTime,
  status,
  backHref,
} = Astro.props;

const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(publishedAt);
const updated = updatedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(updatedAt)
  : null;
const sectionLabel = kind;
const sectionNavLabel =
  kind === "文档" ? "DOCUMENTS" : kind === "思考" ? "WRITING" : "PROJECTS";
const theme =
  kind === "文档" ? "document" : kind === "思考" ? "stone" : "code";
const articleKind =
  kind === "文档" ? "document" : kind === "思考" ? "writing" : "project";
---

<BaseLayout title={title} description={summary} theme={theme}>
  <article
    class:list={[
      "article-shell",
      `article-shell--${articleKind}`,
    ]}
  >
    <Breadcrumbs
      current={number}
      parent={{ label: sectionNavLabel, href: backHref }}
    />
    <header
      class:list={[
        "article-hero",
        { "artifact-destination artifact-destination--document": kind === "文档" },
      ]}
    >
      <div class="article-hero__rail">
        <div class="article-hero__rail-links">
          <a href="/">← HOME</a>
          <a href={backHref}>ALL {sectionNavLabel}</a>
        </div>
        <span>{sectionNavLabel} / {number}</span>
      </div>
      <div class="article-hero__title">
        <span class="eyebrow">{sectionLabel} · {date}</span>
        <h1>{title}</h1>
        <p>{summary}</p>
      </div>
      <dl class="article-hero__meta">
        <div>
          <dt>发布于</dt>
          <dd>{date}</dd>
        </div>
        {updated && (
          <div>
            <dt>修订于</dt>
            <dd>{updated}</dd>
          </div>
        )}
        {readingTime && (
          <div>
            <dt>阅读时间</dt>
            <dd>{readingTime}</dd>
          </div>
        )}
        {status && (
          <div>
            <dt>状态</dt>
            <dd>{status}</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="article-grid">
      <aside class="article-aside">
        <div class="article-aside__sticky">
          <span class="eyebrow">本页目录</span>
          {
            headings.length > 0 ? (
              <ol>
                {headings
                  .filter((heading) => heading.depth <= 3)
                  .map((heading) => (
                    <li class:list={{ "is-sub": heading.depth === 3 }}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
              </ol>
            ) : (
              <p class="muted">这是一篇没有目录的短笔记。</p>
            )
          }
          <div class="article-aside__tags">
            {tags.map((tag) => <span>#{tag}</span>)}
          </div>
        </div>
      </aside>

      <div class="prose">
        <slot />
      </div>

      <aside class="margin-note" aria-label="页边说明">
        <span class="margin-note__mark">※</span>
        <p>这是一份持续工作的记录，会随着实践改变结论而不断修订。</p>
      </aside>
    </div>

    <footer class="article-end">
      <span>正文结束 / {number}</span>
      <div class="article-end__links">
        <a href="/">HOME</a>
        <a href={backHref}>ALL {sectionNavLabel} →</a>
      </div>
    </footer>
  </article>
</BaseLayout>
