---
interface Props {
  owner: string;
  name: string;
  summary: string;
  command: string;
  language: string;
  status: string;
}

const {
  owner,
  name,
  summary,
  command,
  language,
  status,
} = Astro.props;
---

<div class="repo-preview">
  <div class="repo-preview__chrome">
    <span class="repo-preview__mark" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="14" height="14">
        <circle cx="5" cy="5" r="2.2"></circle>
        <circle cx="5" cy="15" r="2.2"></circle>
        <circle cx="15" cy="10" r="2.2"></circle>
        <path d="M5 7.2v5.6M7.2 5h2.3a5.5 5.5 0 0 1 5.5 5"></path>
      </svg>
    </span>
    <span>代码仓库</span>
    <span class="repo-preview__chrome-action">打开 ↗</span>
  </div>

  <div class="repo-preview__identity">
    <div class="repo-preview__path">
      <span>{owner}</span>
      <span aria-hidden="true">/</span>
      <strong>{name}</strong>
    </div>
    <span class="repo-preview__visibility">公开</span>
  </div>

  <div class="repo-preview__nav" aria-hidden="true">
    <span class="is-current">代码</span>
    <span>README</span>
    <span class="repo-preview__branch">
      <svg viewBox="0 0 16 16" width="11" height="11">
        <circle cx="4" cy="3" r="1.5"></circle>
        <circle cx="4" cy="13" r="1.5"></circle>
        <circle cx="12" cy="6" r="1.5"></circle>
        <path d="M4 4.5v7M5.5 6h2A4.5 4.5 0 0 0 12 1.5V4.5"></path>
      </svg>
      主分支
    </span>
  </div>

  <div class="repo-preview__files" aria-hidden="true">
    <div class="repo-preview__file">
      <span class="repo-preview__file-icon">▰</span>
      <strong>src/</strong>
      <span>观察路由决策</span>
    </div>
    <div class="repo-preview__file">
      <span class="repo-preview__file-icon">≡</span>
      <strong>README.md</strong>
      <span>记录实验过程</span>
    </div>
    <div class="repo-preview__file">
      <span class="repo-preview__file-icon">{`{}`}</span>
      <strong>package.json</strong>
      <span>运行当前构建</span>
    </div>
  </div>

  <div class="repo-preview__readme">
    <span class="repo-preview__readme-label">README.md</span>
    <h3>{name.replaceAll("-", " ")}</h3>
    <p>{summary}</p>
    <code><span>$</span> {command}</code>
  </div>

  <div class="repo-preview__footer">
    <span><i></i>{language}</span>
    <span>{status}</span>
  </div>
</div>
