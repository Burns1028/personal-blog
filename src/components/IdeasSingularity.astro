<script>
  const singularity = document.querySelector("[data-ideas-singularity]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (
    singularity instanceof HTMLElement &&
    !reducedMotion.matches &&
    window.innerWidth > 620
  ) {
    const signals = singularity.closest<HTMLElement>(".ideas-signals");
    let motionFrame = 0;
    let watching = false;

    const stopWatching = () => {
      watching = false;
      window.removeEventListener("scroll", scheduleMotionCheck);
      window.removeEventListener("resize", scheduleMotionCheck);
    };

    const revealMotionWhenVisible = () => {
      motionFrame = 0;
      const bounds = singularity.getBoundingClientRect();
      const visibleHeight =
        Math.min(window.innerHeight, bounds.bottom) - Math.max(0, bounds.top);
      const revealThreshold = Math.min(bounds.height * 0.32, 160);

      if (visibleHeight < revealThreshold) return;

      singularity.classList.add("is-motion-ready");
      if (signals) signals.dataset.motionReady = "true";
      stopWatching();
    };

    function scheduleMotionCheck() {
      if (motionFrame) return;
      motionFrame = window.requestAnimationFrame(revealMotionWhenVisible);
    }

    const startWatching = () => {
      if (watching) return;
      watching = true;
      window.addEventListener("scroll", scheduleMotionCheck, { passive: true });
      window.addEventListener("resize", scheduleMotionCheck);
      scheduleMotionCheck();
    };

    if (document.documentElement.dataset.pageSettled === "true") {
      startWatching();
    } else {
      document.addEventListener("burns:page-settled", startWatching, {
        once: true,
      });
    }

    window.addEventListener(
      "pagehide",
      () => {
        if (motionFrame) window.cancelAnimationFrame(motionFrame);
        stopWatching();
      },
      { once: true },
    );
  }
</script>
