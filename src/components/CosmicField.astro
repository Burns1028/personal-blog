---
import { homeOrreryAssets } from "../data/home-orrery-assets";

interface Props {
  mode?: "full" | "stars";
}

const { mode = "full" } = Astro.props;
---

<div
  class:list={[
    "cosmic-field",
    { "cosmic-field--stars-only": mode === "stars" },
  ]}
  aria-hidden="true"
  data-cosmic-field
  data-cosmic-mode={mode}
>
  {
    mode === "full" && (
      <picture>
        <source
          media="(max-width: 1280px)"
          srcset={homeOrreryAssets.background.starfield.mobile}
        />
        <img
          class="cosmic-field__space"
          src={homeOrreryAssets.background.starfield.desktop}
          alt=""
          width="2048"
          height="1152"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )
  }

  <canvas class="cosmic-field__stars" data-cosmic-stars></canvas>

  {
    mode === "full" && (
      <div class="cosmic-field__atmosphere" />
    )
  }
</div>

<script>
  const seededRandom = (seed: number) => {
    let state = seed >>> 0;
    return () => {
      state = (state * 1664525 + 1013904223) >>> 0;
      return state / 4294967296;
    };
  };

  interface Spark {
    x: number;
    y: number;
    depth: number;
    radius: number;
    alpha: number;
    phase: number;
    speed: number;
    warmth: number;
    flare: boolean;
  }

  const sizeCanvas = (
    canvas: HTMLCanvasElement,
    maximumDpr: number,
  ) => {
    const bounds = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, maximumDpr);
    const width = Math.max(1, Math.round(bounds.width * dpr));
    const height = Math.max(1, Math.round(bounds.height * dpr));

    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

    return { width, height, dpr };
  };

  const initCosmicMotion = (
    field: HTMLElement,
    starCanvas: HTMLCanvasElement,
    reducedMotion: boolean,
    saveData: boolean,
  ) => {
    const starContext = starCanvas.getContext("2d");
    if (!starContext) return;

    const pointerSurface =
      field.closest<HTMLElement>(".home-hero, .projects-scene") ?? field;
    const animated = !reducedMotion && !saveData;
    const starRandom = seededRandom(7272026);
    const sparkCount =
      field.dataset.cosmicMode === "stars" ? 64 : 92;
    const sparks: Spark[] = Array.from({ length: sparkCount }, () => {
      const radius = 0.38 + starRandom() * 1.34;
      return {
        x: starRandom(),
        y: starRandom(),
        depth: 0.35 + starRandom() * 0.65,
        radius,
        alpha: 0.18 + starRandom() * 0.68,
        phase: starRandom() * Math.PI * 2,
        speed: 0.52 + starRandom() * 1.38,
        warmth: starRandom(),
        flare: radius > 0.98 && starRandom() > 0.42,
      };
    });

    const maximumDpr = field.dataset.cosmicMode === "stars" ? 1.2 : 1.25;
    const paintInterval = field.dataset.cosmicMode === "stars" ? 60 : 50;
    let starSize = sizeCanvas(starCanvas, maximumDpr);
    let pointerBounds = pointerSurface.getBoundingClientRect();
    let pointerX = 0;
    let pointerY = 0;
    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerCanvasX = 0.5;
    let pointerCanvasY = 0.5;
    let pointerCanvasTargetX = 0.5;
    let pointerCanvasTargetY = 0.5;
    let pointerInfluence = 0;
    let pointerInfluenceTarget = 0;
    let animationFrame = 0;
    let lastDraw = -Infinity;
    let visible = true;
    let navigationPaused = false;

    const drawStars = (seconds: number) => {
      const { width, height, dpr } = starSize;
      starContext.clearRect(0, 0, width, height);
      starContext.globalCompositeOperation = "lighter";

      for (const spark of sparks) {
        const wave = animated
          ? 0.5 + Math.sin(seconds * spark.speed + spark.phase) * 0.5
          : 0.64;
        const glint = Math.pow(wave, 9);
        const parallax = (4 + spark.depth * 24) * dpr;
        let x = spark.x * width + pointerX * parallax;
        let y = spark.y * height + pointerY * parallax * 0.68;
        const cursorDeltaX = x - pointerCanvasX * width;
        const cursorDeltaY = y - pointerCanvasY * height;
        const cursorDistance = Math.hypot(cursorDeltaX, cursorDeltaY);
        const cursorRange = (128 + spark.depth * 84) * dpr;
        const cursorProximity =
          pointerInfluence *
          Math.pow(Math.max(0, 1 - cursorDistance / cursorRange), 2);

        if (cursorProximity > 0.001) {
          const safeDistance = Math.max(0.001, cursorDistance);
          const fallbackAngle = spark.phase + spark.depth * Math.PI;
          const directionX =
            cursorDistance > 0.001
              ? cursorDeltaX / safeDistance
              : Math.cos(fallbackAngle);
          const directionY =
            cursorDistance > 0.001
              ? cursorDeltaY / safeDistance
              : Math.sin(fallbackAngle);
          const displacement =
            cursorProximity * (17 + spark.depth * 27) * dpr;
          x += directionX * displacement;
          y += directionY * displacement;
        }

        const radius =
          spark.radius * dpr * (0.76 + wave * 0.22 + glint * 0.72);
        const interactiveRadius = radius * (1 + cursorProximity * 0.38);
        const alpha = Math.min(
          1,
          spark.alpha *
            (0.22 + wave * 0.56 + glint * 0.34) *
            (1 + cursorProximity * 0.72),
        );
        const warm = spark.warmth > 0.82;

        starContext.beginPath();
        starContext.arc(
          x,
          y,
          Math.max(0.35, interactiveRadius),
          0,
          Math.PI * 2,
        );
        starContext.fillStyle = warm
          ? `rgba(214, 167, 80, ${alpha})`
          : `rgba(239, 236, 225, ${alpha})`;
        starContext.fill();

        if (spark.flare && glint > 0.13) {
          starContext.save();
          starContext.translate(x, y);
          starContext.strokeStyle = `rgba(244, 235, 210, ${alpha * (0.22 + glint * 0.54)})`;
          starContext.lineWidth = Math.max(0.45, 0.55 * dpr);
          starContext.beginPath();
          starContext.moveTo(
            -interactiveRadius * (3.2 + glint * 3.8),
            0,
          );
          starContext.lineTo(
            interactiveRadius * (3.2 + glint * 3.8),
            0,
          );
          starContext.moveTo(
            0,
            -interactiveRadius * (3.2 + glint * 3.8),
          );
          starContext.lineTo(
            0,
            interactiveRadius * (3.2 + glint * 3.8),
          );
          starContext.stroke();
          starContext.restore();
        }
      }
    };

    const draw = (now: number) => {
      const seconds = now / 1000;
      pointerX += (pointerTargetX - pointerX) * 0.065;
      pointerY += (pointerTargetY - pointerY) * 0.065;
      pointerCanvasX += (pointerCanvasTargetX - pointerCanvasX) * 0.14;
      pointerCanvasY += (pointerCanvasTargetY - pointerCanvasY) * 0.14;
      pointerInfluence +=
        (pointerInfluenceTarget - pointerInfluence) * 0.12;
      drawStars(seconds);
    };

    const tick = (now: number) => {
      animationFrame = 0;
      if (now - lastDraw >= paintInterval) {
        lastDraw = now;
        draw(now);
      }
      if (animated && visible && !navigationPaused) {
        animationFrame = requestAnimationFrame(tick);
      }
    };

    const updatePointer = (event: PointerEvent) => {
      if (
        navigationPaused ||
        event.pointerType === "touch" ||
        event.pointerType === "pen"
      ) {
        return;
      }
      pointerCanvasTargetX = Math.min(
        1,
        Math.max(0, (event.clientX - pointerBounds.left) / pointerBounds.width),
      );
      pointerCanvasTargetY = Math.min(
        1,
        Math.max(0, (event.clientY - pointerBounds.top) / pointerBounds.height),
      );
      pointerTargetX = pointerCanvasTargetX * 2 - 1;
      pointerTargetY = pointerCanvasTargetY * 2 - 1;
      pointerInfluenceTarget = 1;
      field.dataset.pointerActive = "true";
      field.style.setProperty(
        "--cosmic-bg-x",
        `${(-pointerTargetX * 9).toFixed(2)}px`,
      );
      field.style.setProperty(
        "--cosmic-bg-y",
        `${(-pointerTargetY * 6).toFixed(2)}px`,
      );
    };

    const resetPointer = () => {
      pointerTargetX = 0;
      pointerTargetY = 0;
      pointerInfluenceTarget = 0;
      field.dataset.pointerActive = "false";
      field.style.setProperty("--cosmic-bg-x", "0px");
      field.style.setProperty("--cosmic-bg-y", "0px");
    };

    const pauseForArtifactNavigation = () => {
      navigationPaused = true;
      field.dataset.navigationPaused = "true";
      cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      pointerSurface.removeEventListener("pointermove", updatePointer);
      pointerSurface.removeEventListener("pointerleave", resetPointer);
      resetPointer();
    };

    document.addEventListener(
      "burns:artifact-navigation-start",
      pauseForArtifactNavigation,
      { once: true },
    );

    const resizeObserver = new ResizeObserver(() => {
      pointerBounds = pointerSurface.getBoundingClientRect();
      starSize = sizeCanvas(starCanvas, maximumDpr);
      draw(performance.now());
    });
    resizeObserver.observe(pointerSurface);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      } else if (animated && !navigationPaused && !animationFrame) {
        animationFrame = requestAnimationFrame(tick);
      }
    });
    intersectionObserver.observe(field);

    if (animated) {
      pointerSurface.addEventListener("pointermove", updatePointer, {
        passive: true,
      });
      pointerSurface.addEventListener("pointerleave", resetPointer);
    }

    draw(performance.now());
    if (animated) animationFrame = requestAnimationFrame(tick);

    window.addEventListener(
      "pagehide",
      () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        intersectionObserver.disconnect();
        pointerSurface.removeEventListener("pointermove", updatePointer);
        pointerSurface.removeEventListener("pointerleave", resetPointer);
        document.removeEventListener(
          "burns:artifact-navigation-start",
          pauseForArtifactNavigation,
        );
      },
      { once: true },
    );
  };

  document.querySelectorAll<HTMLElement>("[data-cosmic-field]").forEach((field) => {
    if (field.dataset.cosmicReady === "true") return;
    field.dataset.cosmicReady = "true";

    const stars = field.querySelector<HTMLCanvasElement>("[data-cosmic-stars]");
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection;

    if (stars) {
      initCosmicMotion(
        field,
        stars,
        window.matchMedia("(prefers-reduced-motion: reduce)").matches,
        Boolean(connection?.saveData),
      );
    }
  });
</script>
