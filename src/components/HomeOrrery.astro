---
import "../styles/home-orrery.css";
import { homeOrreryAssets } from "../data/home-orrery-assets";
const { scene } = homeOrreryAssets;
const destinations = [
  { key: "writing", href: "/writing", label: "Writing", artifact: "document" },
  { key: "projects", href: "/projects", label: "Projects", artifact: "repo" },
  { key: "ideas", href: "/ideas", label: "Ideas", artifact: "idea" },
] as const;
---

<section class="home-orrery" aria-label="Writing、Projects 与 Ideas 思想星系" data-home-orrery data-artifact-stage data-active-artifact="none">
  <div class="home-cosmos__stage">
    <canvas class="home-cosmos__video-canvas" data-celestial-canvas aria-hidden="true"></canvas>
    <video class="home-cosmos__video-source" data-celestial-video data-src={scene.video} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    {destinations.map(({ key, href, label, artifact }) => {
      const subject = scene.subjects[key];
      return <a class={`home-celestial home-celestial--${key}`} href={href} aria-label={`进入 ${label}`} data-artifact={artifact} data-celestial-region={subject.region.join(",")}>
        <img class="home-celestial__poster" src={subject.poster.standard} srcset={`${subject.poster.standard} ${subject.standardWidth}w, ${subject.poster.retina} ${subject.width}w`} sizes={subject.sizes} width={subject.width} height={subject.height} alt="" loading="eager" decoding="async" fetchpriority="high" />
        <span class="sr-only">{label}</span>
      </a>;
    })}
  </div>
</section>

<script>
  import { createCelestialVideoController } from "../lib/home-celestial-video";
  const root = document.querySelector<HTMLElement>("[data-home-orrery]");
  if (root && root.dataset.bound !== "true") {
    root.dataset.bound = "true";
    const canvas = root.querySelector<HTMLCanvasElement>("[data-celestial-canvas]")!;
    const video = root.querySelector<HTMLVideoElement>("[data-celestial-video]")!;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const savesData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let visible = false;
    let settled = document.documentElement.dataset.pageSettled === "true";
    let navigating = false;
    const targets = Array.from(root.querySelectorAll<HTMLElement>("[data-celestial-region]")).map((element) => ({ element, region: element.dataset.celestialRegion!.split(",").map(Number) }));
    const player = createCelestialVideoController(video, canvas, targets, (ready) => {
      root.toggleAttribute("data-video-ready", ready);
    });
    const update = () => player?.setRunning(visible && settled && !navigating && !document.hidden && !reducedMotion.matches && !savesData);
    const onSettled = () => { settled = true; update(); };
    const onNavigation = () => { navigating = true; update(); };
    const onPageShow = () => { navigating = false; update(); };
    const observer = new IntersectionObserver(([entry]) => { visible = entry?.isIntersecting ?? false; update(); });
    const onPageHide = (event: PageTransitionEvent) => {
      navigating = true;
      update();
      if (event.persisted) return;
      observer.disconnect();
      player?.destroy();
      document.removeEventListener("visibilitychange", update);
      document.removeEventListener("burns:page-settled", onSettled);
      document.removeEventListener("burns:artifact-navigation-start", onNavigation);
      reducedMotion.removeEventListener("change", update);
      window.removeEventListener("pageshow", onPageShow);
      window.removeEventListener("pagehide", onPageHide);
    };
    observer.observe(root);
    document.addEventListener("visibilitychange", update);
    document.addEventListener("burns:page-settled", onSettled, { once: true });
    document.addEventListener("burns:artifact-navigation-start", onNavigation);
    reducedMotion.addEventListener("change", update);
    window.addEventListener("pagehide", onPageHide);
    window.addEventListener("pageshow", onPageShow);
  }
</script>
