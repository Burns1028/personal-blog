---
import type { ActivityDay } from "../../lib/server/activity-store";
import {
  activityOrbitPath,
  activityOrbitPointAtX,
} from "../../lib/activity-orbit-geometry";
import SatelliteControl from "./SatelliteControl.astro";

interface Props {
  days: ActivityDay[];
}

const { days } = Astro.props;
const positions = [13, 25, 43, 61, 78, 91].map(activityOrbitPointAtX);
const chronological = days.slice(0, 6).reverse();
const positionOffset = positions.length - chronological.length;
const kindLabels = {
  progress: "进展",
  fix: "修复",
  release: "发布",
  research: "研究",
  maintenance: "维护",
} as const;
const alignmentFor = (left: number) => {
  if (left <= 20) return "start";
  if (left >= 84) return "end";
  return "center";
};
---

<section class="activity-orbit" aria-label="近期活动">
  <svg
    class="activity-orbit__line"
    viewBox="0 0 1000 260"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      data-orbit-path
      d={activityOrbitPath}
      pathLength="1"
    ></path>
  </svg>

  {
    chronological.length > 0 ? (
      <ol class="activity-orbit__days">
        {chronological.map((day, index) => {
          const { left, top } = positions[index + positionOffset];
          const lead = day.items.at(0);
          const isLatest = index === chronological.length - 1;
          const align = alignmentFor(left);
          const detailId = `activity-day-${day.date}`;

          return (
            <li
              class:list={["activity-orbit__day", { "is-current": isLatest }]}
              style={`--node-left:${left}%;--node-top:${top}%;--node-index:${index}`}
              data-activity-node
              data-align={align}
              data-open="false"
              data-latest-activity={isLatest ? "true" : undefined}
            >
              <button
                class="activity-orbit__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={detailId}
                data-activity-trigger
              >
                <span class="activity-orbit__dot" aria-hidden="true" />
                <span class="activity-orbit__summary">
                  <time datetime={day.date}>
                    {day.date.slice(5).replace("-", ".")}
                  </time>
                  <strong>{day.count} 项活动</strong>
                  <small>
                    {lead?.projectSlug ? `${lead.projectSlug}：` : ""}
                    {lead?.title}
                  </small>
                </span>
              </button>

              <article
                id={detailId}
                class="activity-orbit__detail"
                aria-label={`${day.date} 的 ${day.count} 项活动`}
                data-activity-detail
                hidden
              >
                <header class="activity-orbit__detail-header">
                  <time datetime={day.date}>{day.date}</time>
                  <strong>{day.count} 项活动</strong>
                </header>
                <ol class="activity-orbit__records">
                  {day.items.map((item) => (
                    <li class="activity-orbit__record">
                      <p class="activity-orbit__record-meta">
                        <span>{item.projectSlug ?? "独立记录"}</span>
                        <span>{kindLabels[item.kind]}</span>
                      </p>
                      <h3>{item.title}</h3>
                      <p>{item.summary}</p>
                      {item.url ? (
                        <a href={item.url} target="_blank" rel="noreferrer">
                          查看 GitHub 记录 ↗
                        </a>
                      ) : null}
                    </li>
                  ))}
                </ol>
              </article>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="activity-orbit__empty">等待下一次信号</p>
    )
  }

  <div class="activity-orbit__satellite" data-satellite-control-host>
    <SatelliteControl />
  </div>
</section>
