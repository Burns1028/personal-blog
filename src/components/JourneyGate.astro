---
interface Props {
  nextHref: string;
  eyebrow: string;
  title: string;
  linkLabel: string;
  tone: "home-document" | "document-code" | "code-idea";
  artifact?: "repo" | "idea";
}

const {
  nextHref,
  eyebrow,
  title,
  linkLabel,
  tone,
  artifact,
} = Astro.props;

const artifactAssets = {
  repo: {
    src: "/assets/artifact-github-cosmic-720.webp",
    width: 720,
    height: 562,
  },
  idea: {
    src: "/assets/artifact-idea-cosmic-480.webp",
    width: 480,
    height: 585,
  },
} as const;

const artifactAsset = artifact ? artifactAssets[artifact] : undefined;
---

<section
  class:list={["journey-gate", `journey-gate--${tone}`]}
  data-journey-gate
  data-journey-tone={tone}
  data-next-href={nextHref}
  aria-label={`${title} ${linkLabel}`}
>
  <div class="journey-gate__surface">
    <div class="journey-gate__copy">
      <span>{eyebrow}</span>
      <h2>{title}</h2>
      <a href={nextHref} data-journey-link>
        {linkLabel}
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    {
      artifactAsset && artifact && (
        <div
          class:list={[
            "journey-gate__artifact",
            `journey-gate__artifact--${artifact}`,
          ]}
          aria-hidden="true"
        >
          <img
            src={artifactAsset.src}
            alt=""
            width={artifactAsset.width}
            height={artifactAsset.height}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="journey-gate__meter" aria-hidden="true">
      <i></i>
    </div>
  </div>
</section>

<script>
  const clampJourney = (value: number, min = 0, max = 1) =>
    Math.min(max, Math.max(min, value));

  document.querySelectorAll<HTMLElement>("[data-journey-gate]").forEach((gate) => {
    if (gate.dataset.journeyReady === "true") return;
    gate.dataset.journeyReady = "true";

    const root = document.documentElement;
    const nextHref = gate.dataset.nextHref;
    const tone = gate.dataset.journeyTone;
    const link = gate.querySelector<HTMLAnchorElement>("[data-journey-link]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let lastScrollY = window.scrollY;
    let journeyTravel = 0;
    let userIntent = false;
    let frame = 0;
    let committed = false;

    if (!nextHref) return;

    const rememberJourney = () => {
      sessionStorage.setItem(
        "burns:journey",
        JSON.stringify({
          from: window.location.pathname,
          to: nextHref,
          direction: "forward",
          at: Date.now(),
        }),
      );
    };

    const navigate = () => {
      if (committed) return;
      committed = true;
      gate.dataset.committed = "true";
      root.dataset.journeyLeaving = tone ?? "";
      rememberJourney();

      window.setTimeout(
        () => window.location.assign(nextHref),
        reducedMotion.matches ? 0 : 180,
      );
    };

    const setHomeProgress = (progress: number) => {
      if (tone !== "home-document") return;

      const compact = window.matchMedia("(max-width: 680px)").matches;
      const copyOpacity = clampJourney(1 - progress * 1.35);
      const secondaryOpacity = clampJourney(1 - progress * 1.6);
      const paperScale = 1 + progress * (compact ? 0.16 : 0.29);
      const paperX = progress * (compact ? -24 : -96);
      const paperY = progress * (compact ? -18 : -132);
      const veilOpacity = progress * 0.64;

      root.style.setProperty("--home-journey-progress", progress.toFixed(4));
      root.style.setProperty("--home-copy-opacity", copyOpacity.toFixed(4));
      root.style.setProperty(
        "--home-copy-y",
        `${(progress * -28).toFixed(2)}px`,
      );
      root.style.setProperty(
        "--home-secondary-opacity",
        secondaryOpacity.toFixed(4),
      );
      root.style.setProperty("--home-paper-scale", paperScale.toFixed(4));
      root.style.setProperty("--home-paper-x", `${paperX.toFixed(2)}px`);
      root.style.setProperty("--home-paper-y", `${paperY.toFixed(2)}px`);
      root.style.setProperty("--home-veil-opacity", veilOpacity.toFixed(4));
      root.dataset.homeJourneyActive = progress > 0.015 ? "true" : "false";
    };

    const update = () => {
      frame = 0;
      const bounds = gate.getBoundingClientRect();
      const viewportHeight = Math.max(1, window.innerHeight);
      const progress = clampJourney(
        (viewportHeight - bounds.top) / Math.max(1, bounds.height * 0.94),
      );
      const reveal = clampJourney((progress - 0.08) / 0.72);
      const delta = window.scrollY - lastScrollY;

      if (delta > 0 && progress > 0.02) {
        journeyTravel += delta;
      } else if (delta < -4) {
        journeyTravel = Math.max(0, journeyTravel + delta * 2);
        userIntent = false;
      }
      lastScrollY = window.scrollY;

      gate.style.setProperty("--journey-progress", progress.toFixed(4));
      gate.style.setProperty("--journey-reveal", reveal.toFixed(4));
      gate.style.setProperty(
        "--journey-mobile-artifact-opacity",
        (reveal * 0.48).toFixed(4),
      );
      gate.style.setProperty(
        "--journey-copy-y",
        `${((1 - reveal) * 34).toFixed(2)}px`,
      );
      gate.style.setProperty(
        "--journey-artifact-y",
        `${((1 - reveal) * 92).toFixed(2)}px`,
      );
      gate.style.setProperty(
        "--journey-artifact-scale",
        (0.88 + reveal * 0.12).toFixed(4),
      );
      setHomeProgress(progress);

      const travelThreshold = Math.min(
        360,
        Math.max(180, bounds.height * 0.5),
      );
      if (
        userIntent &&
        progress >= 0.965 &&
        journeyTravel >= travelThreshold
      ) {
        navigate();
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const markWheelIntent = (event: WheelEvent) => {
      if (event.deltaY > 0) userIntent = true;
    };

    const markTouchIntent = () => {
      userIntent = true;
    };

    const markKeyIntent = (event: KeyboardEvent) => {
      if (
        ["ArrowDown", "PageDown", "End", " ", "Spacebar"].includes(event.key)
      ) {
        userIntent = true;
      }
    };

    link?.addEventListener("click", rememberJourney);
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
    window.addEventListener("wheel", markWheelIntent, { passive: true });
    window.addEventListener("touchstart", markTouchIntent, { passive: true });
    window.addEventListener("keydown", markKeyIntent);
    update();

    window.addEventListener(
      "pagehide",
      () => {
        cancelAnimationFrame(frame);
        window.removeEventListener("scroll", requestUpdate);
        window.removeEventListener("resize", requestUpdate);
        window.removeEventListener("wheel", markWheelIntent);
        window.removeEventListener("touchstart", markTouchIntent);
        window.removeEventListener("keydown", markKeyIntent);
        link?.removeEventListener("click", rememberJourney);
      },
      { once: true },
    );
  });
</script>
