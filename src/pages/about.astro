---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.author} and this working archive.`} paper>
  <section class="about-spread">
    <div class="about-spread__portrait" aria-label="Burns monogram">
      <span class="about-spread__monogram">B.</span>
    </div>
    <div class="about-spread__body">
      <span class="eyebrow">ABOUT</span>
      <h1>Hi, I’m<br />{site.author}.</h1>
      <p>
        I care about how complex systems are understood and operated—and how
        technical work can leave behind knowledge that is useful more than once.
      </p>
      <p>
        This site is a public workbench: essays develop an argument, documents
        preserve a method, and code tests whether the idea survives.
      </p>
      <dl class="about-spread__facts">
        <div>
          <dt>WORKING ON</dt>
          <dd>Agent Applications / LLM Infrastructure</dd>
        </div>
        <div>
          <dt>ELSEWHERE</dt>
          <dd><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
