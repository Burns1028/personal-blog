---
import BaseLayout from "../layouts/BaseLayout.astro";
import CosmicField from "../components/CosmicField.astro";
import HomeOrrery from "../components/HomeOrrery.astro";
import { contacts } from "../data/site";
---

<BaseLayout>
  <section class="home-hero act act--intro" id="intro" aria-labelledby="home-title">
    <CosmicField />

    <div class="home-hero__inner">
      <div class="home-hero__copy" data-intro-copy>
          <h1
            id="home-title"
            aria-label="Hello I am Burns"
          >
            <span class="term-line">
              <span class="term-prompt" aria-hidden="true">
                <b>&gt;</b> whoami
              </span>
            </span>
            <span class="term-line term-line--identity">
              <span class="hero-portrait" aria-hidden="true">
                <picture>
                  <source
                    media="(min-resolution: 1.5dppx)"
                    srcset="/assets/home-profile-burns-640.webp"
                  />
                  <img
                    src="/assets/home-profile-burns-320.webp"
                    width="320"
                    height="427"
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                </picture>
                <i class="hero-portrait__star"></i>
              </span>
              <span
                class="term-name"
                data-typewriter
              data-typewriter-text="Hello I am Burns"
              data-typewriter-signature-text="Burns"
              >
                <span class="term-name__line term-name__line--prefix">
                  <span data-typewriter-prefix>Hello I am </span>
                  <i
                    class="term-typewriter-caret"
                    data-typewriter-prefix-caret
                    aria-hidden="true"
                  ></i>
                </span>
                <span class="term-name__line term-name__line--signature">
                  <span class="term-signature" data-typewriter-signature>Burns</span>
                  <i
                    class="term-typewriter-caret"
                    data-typewriter-signature-caret
                    aria-hidden="true"
                    hidden
                  ></i>
                </span>
              </span>
              <i class="hero-title-star" aria-hidden="true"></i>
            </span>
            </h1>
            <div class="hero-profile">
              <p class="hero-profile__fact hero-profile__work">
                <span class="hero-profile__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/agent-systems.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span class="hero-profile__copy">
                  Building agent systems.
                  {/* Restore the ByteDance Seed affiliation after the transfer:
                  at
                  <a
                    href="https://seed.bytedance.com/en/"
                    target="_blank"
                    rel="noreferrer"
                  >
                    <img
                      class="hero-profile__seed-logo"
                      src="/assets/bytedance-seed-official-v1.png"
                      alt="ByteDance Seed"
                      width="984"
                      height="120"
                      decoding="async"
                    />
                  </a>. */}
                </span>
              </p>
              <p class="hero-profile__fact hero-profile__identity">
                <span class="hero-profile__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/location.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span class="hero-profile__copy">
                  An absurdist from <span class="hero-profile__place">Shanghai</span>.
                </span>
              </p>
              <p class="hero-profile__fact hero-profile__education">
                <span class="hero-profile__copy hero-profile__education-copy">
                  <a
                    class="hero-profile__institution-logo"
                    href="https://english.pku.edu.cn/index.html"
                    target="_blank"
                    rel="noreferrer"
                  >
                    <img
                      class="hero-profile__pku-logo"
                      src="/assets/peking-university-lockup-v1.png"
                      alt="Peking University"
                      width="610"
                      height="179"
                      decoding="async"
                    />
                  </a><span
                    class="hero-profile__education-note"
                  >{" graduate."}</span>
                </span>
              </p>
              <p class="hero-profile__fact hero-profile__horizon">
                <span class="hero-profile__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/ai-horizon.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span class="hero-profile__copy">
                  Exploring <span class="hero-profile__ai">AI<sup>*</sup></span> and whatever comes next.
                </span>
              </p>
          </div>
          <section class="hero-invitation" aria-labelledby="hero-invitation-title">
            <h2 id="hero-invitation-title">Let’s be friends.</h2>
            <i class="hero-invitation__mark" aria-hidden="true"></i>
            <nav class="hero-actions" aria-label="Explore Burns’ work">
              <a href="/projects" data-artifact="repo">
                <span class="hero-actions__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/projects.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span>Projects</span>
                <b aria-hidden="true">→</b>
              </a>
              <a href="/writing" data-artifact="document">
                <span class="hero-actions__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/writing.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span>Writing</span>
                <b aria-hidden="true">→</b>
              </a>
              <a href="/ideas" data-artifact="idea">
                <span class="hero-actions__icon" aria-hidden="true">
                  <img
                    src="/assets/home-icons/ideas.webp"
                    alt=""
                    width="96"
                    height="96"
                    decoding="async"
                  />
                </span>
                <span>Ideas</span>
                <b aria-hidden="true">→</b>
              </a>
            </nav>
          </section>
          <section class="hero-contact-block" aria-labelledby="hero-contact-title">
            <h3 id="hero-contact-title" class="hero-contact-block__title">Contact me</h3>
            <nav id="contact-links" class="contact-strip" aria-label="Contact Burns">
            {
              contacts.map((contact) => {
                const icon = (
                  <svg
                    class="contact-strip__icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    {
                      contact.icon === "x" ? (
                        <path d="M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.84L7.08 4.13H5.12l11.96 15.64Z" />
                      ) : contact.icon === "jike" ? (
                        <path d="M8.05 2.75h8.38v11.08c0 4.66-2.72 7.42-7.18 7.42-2.52 0-4.57-.9-5.91-2.54l2.88-2.96c.77.88 1.68 1.35 2.82 1.35 1.8 0 2.72-1.03 2.72-3.41V6.76H8.05V2.75Z" />
                      ) : contact.icon === "github" ? (
                        <path
                          d="M12 2.8a9.2 9.2 0 0 0-2.91 17.93c.46.08.63-.2.63-.45v-1.77c-2.57.56-3.11-1.09-3.11-1.09-.42-1.07-1.03-1.35-1.03-1.35-.84-.58.06-.57.06-.57.93.07 1.42.96 1.42.96.83 1.42 2.17 1.01 2.7.77.08-.6.32-1.01.59-1.24-2.05-.23-4.2-1.02-4.2-4.55 0-1 .36-1.83.95-2.47-.1-.23-.41-1.17.09-2.43 0 0 .77-.25 2.53.94A8.8 8.8 0 0 1 12 7.18a8.8 8.8 0 0 1 2.3.31c1.76-1.19 2.53-.94 2.53-.94.5 1.26.19 2.2.09 2.43.59.64.95 1.46.95 2.47 0 3.54-2.16 4.31-4.21 4.54.33.29.62.85.62 1.71v2.58c0 .25.17.54.63.45A9.2 9.2 0 0 0 12 2.8Z"
                        />
                      ) : contact.icon === "wechat" ? (
                        <>
                          <path d="M10.1 5.1c-4.3 0-7.3 2.6-7.3 5.8 0 1.8 1 3.5 2.8 4.6l-.7 2.1 2.5-1.2c.8.2 1.7.4 2.7.4 4.2 0 7.3-2.6 7.3-5.9s-3.1-5.8-7.3-5.8Z" />
                          <path d="M14.7 10.1c3.8 0 6.5 2.3 6.5 5.2 0 1.6-.9 3.1-2.5 4.1l.6 1.9-2.2-1.1c-.8.2-1.5.3-2.4.3-3.8 0-6.5-2.3-6.5-5.2" />
                          <circle cx="7.7" cy="9.7" r=".65" />
                          <circle cx="12.4" cy="9.7" r=".65" />
                          <circle cx="12.6" cy="14.5" r=".6" />
                          <circle cx="16.8" cy="14.5" r=".6" />
                        </>
                      ) : (
                        <>
                          <rect x="3" y="5.2" width="18" height="13.6" rx="1.2" />
                          <path d="m4.2 6.6 7.8 6 7.8-6" />
                        </>
                      )
                    }
                  </svg>
                );

                return contact.kind === "link" ? (
                  <a
                    href={contact.href}
                    target={contact.href.startsWith("mailto:") ? undefined : "_blank"}
                    rel={contact.href.startsWith("mailto:") ? undefined : "noreferrer"}
                    aria-label={contact.label}
                    data-contact-tooltip={contact.label}
                    data-contact-icon={contact.icon}
                  >
                    {icon}
                  </a>
                ) : (
                  <button
                    type="button"
                    aria-label={`Copy ${contact.label}: ${contact.value}`}
                    data-contact-copy
                    data-contact-value={contact.value}
                    data-contact-tooltip={`${contact.label} · copy`}
                    data-contact-icon={contact.icon}
                  >
                    {icon}
                  </button>
                );
              })
            }
            <span
              class="contact-strip__status"
              role="status"
              aria-live="polite"
              data-contact-status
            ></span>
            </nav>
          </section>
        </div>

      <HomeOrrery />
    </div>
  </section>

  <script>
    const root = document.documentElement;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const stage = document.querySelector<HTMLElement>("[data-artifact-stage]");
    const artifacts = document.querySelectorAll<HTMLElement>("[data-artifact]");
    const artifactEntrypoints =
      document.querySelectorAll<HTMLAnchorElement>(
        ".hero-actions > a[data-artifact]",
      );
    const typewriter =
      document.querySelector<HTMLElement>("[data-typewriter]");
    const typewriterPrefix =
      typewriter?.querySelector<HTMLElement>("[data-typewriter-prefix]");
    const typewriterSignature =
      typewriter?.querySelector<HTMLElement>("[data-typewriter-signature]");
    const typewriterPrefixCaret =
      typewriter?.querySelector<HTMLElement>("[data-typewriter-prefix-caret]");
    const typewriterSignatureCaret =
      typewriter?.querySelector<HTMLElement>("[data-typewriter-signature-caret]");
    const typewriterText =
      typewriter?.dataset.typewriterText ??
      typewriter?.textContent?.trim() ??
      "";
    const typewriterSignatureText =
      typewriter?.dataset.typewriterSignatureText ??
      typewriterSignature?.textContent?.trim() ??
      "";
    let typewriterTimer = 0;
    let contactStatusTimer = 0;

    const startTypewriter = () => {
      if (!typewriter) return;

      const typewriterElement = typewriter;
      typewriterElement.dataset.typewriterReady = "true";
      const characters = Array.from(typewriterText);
      const signatureStart = Math.max(
        0,
        characters.length - Array.from(typewriterSignatureText).length,
      );
      let index = 0;
      const renderTypewriter = (visibleCharacters: string[]) => {
        if (typewriterPrefix && typewriterSignature) {
          typewriterPrefix.textContent = visibleCharacters
            .slice(0, signatureStart)
            .join("");
          typewriterSignature.textContent = visibleCharacters
            .slice(signatureStart)
            .join("");
          const isTypingSignature = visibleCharacters.length > signatureStart;
          if (typewriterPrefixCaret) {
            typewriterPrefixCaret.hidden = isTypingSignature;
          }
          if (typewriterSignatureCaret) {
            typewriterSignatureCaret.hidden = !isTypingSignature;
          }
          return;
        }

        typewriterElement.textContent = visibleCharacters.join("");
      };

      if (reduceMotion.matches) {
        renderTypewriter(characters);
        typewriterElement.dataset.typewriterState = "complete";
        return;
      }

      renderTypewriter([]);
      typewriterElement.dataset.typewriterState = "typing";

      const scheduleTypewriter = (callback: () => void, delay: number) => {
        typewriterTimer = window.setTimeout(callback, delay);
      };

      function typeNextCharacter() {
        index += 1;
        renderTypewriter(characters.slice(0, index));

        if (index >= characters.length) {
          typewriterElement.dataset.typewriterState = "complete";
          return;
        }

        const currentCharacter = characters[index - 1];
        scheduleTypewriter(
          typeNextCharacter,
          currentCharacter === " " ? 42 : 68,
        );
      }

      scheduleTypewriter(typeNextCharacter, 360);
    };

    const setReady = () => {
      requestAnimationFrame(() => {
        root.classList.add("motion-ready");
        startTypewriter();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setReady, { once: true });
    } else {
      setReady();
    }

    if (stage) {
      const setActiveArtifact = (artifact = "none") => {
        stage.dataset.activeArtifact = artifact;
      };

      artifacts.forEach((artifact) => {
        const kind = artifact.dataset.artifact;
        if (!kind) return;
        artifact.addEventListener("pointerenter", () => setActiveArtifact(kind));
        artifact.addEventListener("focusin", () => setActiveArtifact(kind));
        artifact.addEventListener("click", () => {
          sessionStorage.setItem("burns:last-artifact", kind);
        });
      });

      artifactEntrypoints.forEach((entry) => {
        entry.addEventListener("pointerleave", () => setActiveArtifact());
        entry.addEventListener("focusout", (event) => {
          const next = event.relatedTarget;
          if (!(next instanceof Node) || !entry.contains(next)) {
            setActiveArtifact();
          }
        });
      });

      stage.addEventListener("pointerleave", () => setActiveArtifact());
      stage.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !stage.contains(next)) setActiveArtifact();
      });
    }

    const contactStatus =
      document.querySelector<HTMLElement>("[data-contact-status]");
    const contactCopyButtons =
      document.querySelectorAll<HTMLButtonElement>("[data-contact-copy]");

    const copyContact = async (value: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error("Clipboard API unavailable");
      }

      await navigator.clipboard.writeText(value);
    };

    contactCopyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.contactValue;
        if (!value) return;

        window.clearTimeout(contactStatusTimer);

        try {
          await copyContact(value);
          button.dataset.copied = "true";
          if (contactStatus) contactStatus.textContent = `Copied: ${value}`;
        } catch {
          if (contactStatus) contactStatus.textContent = `WeChat: ${value}`;
        }

        contactStatusTimer = window.setTimeout(() => {
          delete button.dataset.copied;
          if (contactStatus) contactStatus.textContent = "";
        }, 2200);
      });
    });

    window.addEventListener(
      "pagehide",
      () => {
        window.clearTimeout(typewriterTimer);
        window.clearTimeout(contactStatusTimer);
      },
      { once: true },
    );

    document.addEventListener(
      "burns:artifact-navigation-start",
      () => {
        window.clearTimeout(typewriterTimer);
        window.clearTimeout(contactStatusTimer);
      },
      { once: true },
    );

  </script>
</BaseLayout>
