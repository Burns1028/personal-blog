---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readingNow } from "../data/reading";
import { site } from "../data/site";

const writings = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const documents = (await getCollection("docs", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featuredWriting = writings.find(({ data }) => data.featured) ?? writings[0];
const featuredDoc = documents.find(({ data }) => data.featured) ?? documents[0];
const featuredProject = projects.find(({ data }) => data.featured) ?? projects[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  }).format(date);
---

<BaseLayout>
  <section class="home-hero act act--intro" id="intro" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <span class="act-label">ACT I / INTRODUCTION</span>
      <h1 id="home-title">
        I’m Burns.
        <span class="accent-line">I make complex systems easier to reason about.</span>
      </h1>
      <p>
        I work on agent systems, LLM infrastructure, product design, and the craft
        of turning uncertain ideas into things that run.
      </p>
      <div class="hero-actions">
        <a class="button button--accent" href={`/writing/${featuredWriting.id}`}>
          Read the latest note <span aria-hidden="true">→</span>
        </a>
        <a class="button" href="/docs">Browse documents</a>
      </div>
    </div>

    <div class="artifact-stage" aria-label="Featured document and project">
      <a class="paper-artifact" href={`/docs/${featuredDoc.id}`}>
        <div class="paper-artifact__mast">
          <strong>{site.shortTitle}</strong>
          <span>{featuredDoc.data.number}</span>
        </div>
        <div class="paper-artifact__category">
          <span>{featuredDoc.data.section}</span>
          <span>UPDATED {formatDate(featuredDoc.data.updatedAt ?? featuredDoc.data.publishedAt)}</span>
        </div>
        <h2>{featuredDoc.data.title}</h2>
        <p class="paper-artifact__deck">{featuredDoc.data.summary}</p>
        <div class="paper-artifact__columns" aria-hidden="true">
          <p>
            Start with a clear task contract. Inspect the trace, name the failure
            mode, and keep the evidence that makes the next iteration possible.
          </p>
        </div>
        <div class="paper-artifact__open">
          <span>OPEN DOCUMENT</span>
          <span>{featuredDoc.data.status.toUpperCase()} →</span>
        </div>
      </a>

      <a
        class="code-docket"
        href={featuredProject.data.repo}
        target="_blank"
        rel="noreferrer"
        aria-label={`Open ${featuredProject.data.title} on GitHub`}
      >
        <div class="code-docket__bar">
          <span>FEATURED PROJECT</span>
          <span>{featuredProject.data.number}</span>
        </div>
        <pre><span class="code-comment"># run the current build</span>
<span class="code-accent">$</span> {featuredProject.data.command}

<span class="code-comment"># {featuredProject.data.summary}</span></pre>
        <div class="code-docket__footer">
          <span>OPEN GITHUB</span>
          <span>{featuredProject.data.language.toUpperCase()} ↗</span>
        </div>
      </a>
    </div>
  </section>

  <section class="paper-world act act--thinking" id="thinking" aria-labelledby="thinking-title">
    <div class="editorial-section">
      <header class="section-heading">
        <span class="act-label act-label--ink">ACT II / THINKING</span>
        <h2 id="thinking-title">What I’m thinking about.</h2>
        <p>Working notes on systems, tools, reliability, and the choices hiding inside technical work.</p>
      </header>
      <ol class="writing-list">
        {
          writings.slice(0, 3).map((entry) => (
            <li>
              <a class="writing-row" href={`/writing/${entry.id}`}>
                <span class="writing-row__number">{entry.data.number}</span>
                <div class="writing-row__main">
                  <h3>{entry.data.title}</h3>
                  <span class="writing-row__tags">
                    {entry.data.tags.map((tag) => <span>#{tag}</span>)}
                  </span>
                </div>
                <div class="writing-row__summary">
                  <time datetime={entry.data.publishedAt.toISOString()}>
                    {formatDate(entry.data.publishedAt)} · {entry.data.readingTime}
                  </time>
                  {entry.data.summary}
                </div>
              </a>
            </li>
          ))
        }
      </ol>
      <a class="act-link act-link--ink" href="/writing">View all writing →</a>
    </div>
  </section>

  <section class="reading-act act" id="reading" aria-labelledby="reading-title">
    <div class="reading-act__inner">
      <header class="section-heading">
        <span class="act-label">ACT III / READING</span>
        <h2 id="reading-title">What’s on my desk.</h2>
        <p>Books and papers that are currently changing how I frame the work.</p>
      </header>
      <ol class="reading-shelf">
        {
          readingNow.map((item, index) => (
            <li class="reading-entry">
              <span class="reading-entry__number">{String(index + 1).padStart(2, "0")}</span>
              <div class="reading-entry__title">
                <span>{item.kind} / {item.author}</span>
                <h3>{item.title}</h3>
              </div>
              <p>{item.note}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="project-dark act act--building" id="building" aria-labelledby="building-title">
    <div class="project-dark__inner">
      <header class="section-heading section-heading--dark">
        <span class="act-label">ACT IV / BUILDING</span>
        <h2 id="building-title">What we’re building now.</h2>
        <p>Small systems and experiments where an idea has to survive contact with code.</p>
      </header>
      <div class="project-cases">
        {
          projects.slice(0, 3).map((entry) => (
            <a class="project-case" href={entry.data.repo} target="_blank" rel="noreferrer">
              <span class="project-case__top">
                <span>{entry.data.number}</span>
                <span>{entry.data.status.toUpperCase()}</span>
              </span>
              <pre><span class="code-comment"># quick start</span>
<span class="code-accent">$</span> {entry.data.command}</pre>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <span class="project-case__open">
                <span>{entry.data.language}</span>
                <span>OPEN REPOSITORY ↗</span>
              </span>
            </a>
          ))
        }
      </div>
      <a class="act-link" href="/projects">View all projects →</a>
    </div>
  </section>
</BaseLayout>
