---
import ArchivePagination from "../../components/archive/ArchivePagination.astro";
import LunarPhase from "../../components/writing/LunarPhase.astro";
import WritingTypeFilter from "../../components/writing/WritingTypeFilter.astro";
import { archiveAssets } from "../../data/archive-assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { normalizeSearch, paginate } from "../../lib/archive-query";
import { getLunarPhase } from "../../lib/lunar-phase";
import { getWritingCatalog } from "../../lib/server/writing-catalog";
import {
  filterWriting,
  listWritingTypes,
  normalizeWritingType,
  writingArchiveHref,
} from "../../lib/writing-archive";
import "../../styles/writing-archive-v2.css";

export const prerender = false;

const query = normalizeSearch(Astro.url.searchParams.get("q"));
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const catalog = await getWritingCatalog();
const types = listWritingTypes(catalog);
const activeType = normalizeWritingType(Astro.url.searchParams.get("type"), types);
const directory = activeType ? filterWriting(catalog, activeType, "") : [];
const entries = filterWriting(catalog, activeType, query);
const result = paginate(entries, requestedPage, 4);
const hrefFor = (page: number) => writingArchiveHref({ type: activeType, query, page });
const currentPhase = getLunarPhase(new Date());
const phaseCenters = [3.83, 12.92, 23.92, 35.17, 48, 60.71, 72.04, 83.38];
const currentPhasePosition = phaseCenters[currentPhase.index];
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<BaseLayout
  title="Writing"
  description="长文、工作反思，以及那些值得被说完整的想法。"
  theme="paper"
>
  <section class="writing-v2" data-writing-archive>
    <picture class="writing-v2__atlas" aria-hidden="true">
      <source
        media="(max-width: 767px)"
        srcset={archiveAssets.writing.atlas.mobile}
      />
      <source
        srcset={`${archiveAssets.writing.atlas.desktop} 1x, ${archiveAssets.writing.atlas.desktop2x} 2x`}
      />
      <img
        src={archiveAssets.writing.atlas.desktop}
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="writing-v2__column">
      <h1 class="sr-only">Writing</h1>

      <div
        class="writing-v2__phase-strip"
        role="img"
        aria-label={`连续月相图，当前月相：${currentPhase.name}`}
        title={`当前月相：${currentPhase.name}`}
        style={`--current-phase-x:${currentPhasePosition}%`}
      >
        <span class="writing-v2__phase-glow" aria-hidden="true"></span>
        <picture aria-hidden="true">
          <source
            media="(max-width: 767px)"
            srcset={archiveAssets.writing.phaseStrip.mobile}
          />
          <img
            class="writing-v2__phase-strip-image"
            src={archiveAssets.writing.phaseStrip.desktop}
            alt=""
            width="1200"
            height="203"
            decoding="async"
          />
        </picture>
      </div>

      <form
        class="archive-search archive-search--writing"
        method="get"
        action="/writing"
        role="search"
      >
        {activeType && <input type="hidden" name="type" value={activeType} />}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.4"></circle>
          <path d="m15.5 15.5 4.2 4.2"></path>
        </svg>
        <input
          id="writing-search"
          type="search"
          name="q"
          value={query}
          aria-label="搜索文章、主题或关键词"
          placeholder="搜索文章、主题或关键词"
          autocomplete="off"
        />
        <kbd>⌘ K</kbd>
      </form>

      <WritingTypeFilter
        types={types}
        activeType={activeType}
        query={query}
        total={catalog.length}
        directory={directory}
      />

      <p class="writing-v2__result-count" role="status">
        {query ? `搜索“${query}” · ` : ""}共 {result.total} 篇文章
      </p>

      {
        result.items.length > 0 ? (
          <ol class="writing-v2__list" data-archive-results>
            {result.items.map((entry, index) => {
              const phase = getLunarPhase(entry.data.publishedAt);
              return (
                <li style={`--entry-index:${index}`}>
                  <a href={`/writing/${entry.id}`}>
                    <div class="writing-v2__entry-copy">
                      <h2>{entry.data.title}</h2>
                      <p>{entry.data.deck ?? entry.data.summary}</p>
                    </div>
                    <div class="writing-v2__meta">
                      <span>
                        <time
                          datetime={entry.data.publishedAt.toISOString()}
                        >
                          {formatDate(entry.data.publishedAt)}
                        </time>
                        <small>{entry.data.readingTime}阅读</small>
                      </span>
                      <LunarPhase phase={phase} />
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <div class="archive-empty">
            <p>没有找到{activeType ? "这个主题下" : ""}与搜索匹配的文章。</p>
            <a href={writingArchiveHref({ type: activeType })}>清空搜索</a>
          </div>
        )
      }

      <ArchivePagination
        page={result.page}
        pageCount={result.pageCount}
        hrefFor={hrefFor}
        label="文章分页"
      />
    </div>
  </section>

  <script>
    document.addEventListener("keydown", (event) => {
      if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "k"
      ) {
        const input = document.querySelector("#writing-search");
        if (input instanceof HTMLInputElement) {
          event.preventDefault();
          input.focus();
        }
      }
    });
  </script>
</BaseLayout>
