---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

const entries = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<BaseLayout
  title="Writing"
  description="长文、工作反思，以及那些值得被说完整的想法。"
  theme="paper"
>
  <div class="writing-archive">
    <div class="writing-archive__inner">
      <div
        class="writing-archive__watermark artifact-destination artifact-destination--document"
        aria-hidden="true"
      >
        <img
          src="/assets/artifact-document-cosmic-640.webp"
          srcset="/assets/artifact-document-cosmic-640.webp 640w, /assets/artifact-document-cosmic-960.webp 960w"
          sizes="(max-width: 680px) 220px, 420px"
          alt=""
          width="960"
          height="1300"
          loading="eager"
          decoding="async"
        />
      </div>

      <section class="writing-index" aria-label="文章列表">
        <ol class="writing-list">
          {
            entries.map((entry, index) => (
              <li>
                <a
                  class:list={[
                    "writing-entry",
                    { "writing-entry--lead": index === 0 },
                  ]}
                  href={`/writing/${entry.id}`}
                >
                  <div class="writing-entry__body">
                    {
                      index === 0
                        ? <h1>{entry.data.title}</h1>
                        : <h2>{entry.data.title}</h2>
                    }
                    <p>{entry.data.summary}</p>
                  </div>

                  <p class="writing-entry__meta">
                    <time datetime={entry.data.publishedAt.toISOString()}>
                      {formatDate(entry.data.publishedAt)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{entry.data.readingTime}阅读</span>
                    <span aria-hidden="true">·</span>
                    <span>{site.author}</span>
                  </p>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>
