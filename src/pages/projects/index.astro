---
import ActivityOrbit from "../../components/projects/ActivityOrbit.astro";
import ArchivePagination from "../../components/archive/ArchivePagination.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import RotatingEarth from "../../components/projects/RotatingEarth.astro";
import { archiveAssets } from "../../data/archive-assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  matchesSearch,
  pageHref,
  paginate,
} from "../../lib/archive-query";
import { listActivityDays } from "../../lib/server/activity-store";
import { listPublishedProjects } from "../../lib/server/project-store";
import "../../styles/projects-archive-v2.css";

export const prerender = false;

const entries = listPublishedProjects();
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const filtered = entries.filter((entry) =>
  matchesSearch(
    [
      entry.title,
      entry.slug,
      entry.githubFullName,
      entry.summary,
      entry.language,
      entry.status,
    ],
    query,
  ),
);
const result = paginate(filtered, requestedPage, 3);
const hrefFor = (page: number) => pageHref("/projects", page, query);
const activityDays = listActivityDays(6);
---

<BaseLayout title="项目" description="可以打开、运行和验证的代码仓库与实验。" theme="code">
  <section class="projects-v2" data-projects-archive>
    <picture class="projects-v2__space" aria-hidden="true">
      <source
        media="(max-width: 767px)"
        srcset={archiveAssets.projects.space.mobile}
      />
      <source
        srcset={`${archiveAssets.projects.space.desktop} 1x, ${archiveAssets.projects.space.desktop2x} 2x`}
      />
      <img
        src={archiveAssets.projects.space.desktop}
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <RotatingEarth />

    <div class="projects-v2__workbench">
      <header class="projects-v2__header">
        <h1><span aria-hidden="true">&gt;</span> ls ./projects</h1>
        <div class="projects-v2__header-actions">
          <span>近期活动</span>
          <form
            class="archive-search archive-search--projects"
            method="get"
            action="/projects"
            role="search"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5"></circle>
              <path d="m15.5 15.5 5 5"></path>
            </svg>
            <input
              id="projects-search"
              type="search"
              name="q"
              value={query}
              placeholder="搜索项目、技术或状态"
              autocomplete="off"
            />
            <kbd>⌘ K</kbd>
          </form>
        </div>
      </header>

      {
        result.items.length > 0 ? (
          <div class="project-card-grid" aria-label="GitHub 项目" data-archive-results>
            {result.items.map((project) => <ProjectCard project={project} />)}
          </div>
        ) : (
          <div class="archive-empty">
            <p>暂时没有匹配的探索项目。</p>
            <a href="/projects">清空搜索</a>
          </div>
        )
      }

      <ArchivePagination
        page={result.page}
        pageCount={result.pageCount}
        hrefFor={hrefFor}
        label="项目分页"
      />
    </div>

    <ActivityOrbit days={activityDays} />
  </section>

  <script is:inline>
    (() => {
      const satellite = document.querySelector("[data-satellite-control]");
      const latest = document.querySelector(
        "[data-latest-activity='true']",
      );
      const activityNodes = [
        ...document.querySelectorAll("[data-activity-node]"),
      ].filter((node) => node instanceof HTMLElement);
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      function setActivityOpen(node, open) {
        const trigger = node.querySelector("[data-activity-trigger]");
        const detail = node.querySelector("[data-activity-detail]");
        if (
          !(trigger instanceof HTMLButtonElement) ||
          !(detail instanceof HTMLElement)
        ) {
          return;
        }

        node.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
        detail.hidden = !open;
      }

      const closeActivitiesExcept = (current) => {
        for (const node of activityNodes) {
          if (node !== current) setActivityOpen(node, false);
        }
      };

      for (const node of activityNodes) {
        const trigger = node.querySelector("[data-activity-trigger]");
        if (!(trigger instanceof HTMLButtonElement)) continue;

        let touchActivation = false;
        trigger.addEventListener("pointerdown", (event) => {
          touchActivation = event.pointerType !== "mouse";
        });
        node.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "mouse") return;
          closeActivitiesExcept(node);
          setActivityOpen(node, true);
        });
        node.addEventListener("pointerleave", (event) => {
          if (event.pointerType !== "mouse") return;
          if (!node.contains(document.activeElement)) {
            setActivityOpen(node, false);
          }
        });
        node.addEventListener("focusin", () => {
          if (touchActivation) return;
          closeActivitiesExcept(node);
          setActivityOpen(node, true);
        });
        node.addEventListener("focusout", () => {
          requestAnimationFrame(() => {
            if (
              !node.contains(document.activeElement) &&
              !node.matches(":hover")
            ) {
              setActivityOpen(node, false);
            }
          });
        });
        trigger.addEventListener("click", () => {
          const nextOpen = touchActivation
            ? node.dataset.open !== "true"
            : true;
          touchActivation = false;
          closeActivitiesExcept(node);
          setActivityOpen(node, nextOpen);
        });
      }

      document.addEventListener("pointerdown", (event) => {
        const target = event.target;
        if (
          target instanceof Element &&
          !target.closest("[data-activity-node]")
        ) {
          closeActivitiesExcept(null);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const openNode = activityNodes.find(
            (node) => node.dataset.open === "true",
          );
          const trigger = openNode?.querySelector(
            "[data-activity-trigger]",
          );
          if (
            openNode instanceof HTMLElement &&
            trigger instanceof HTMLButtonElement
          ) {
            setActivityOpen(openNode, false);
            trigger.focus({ preventScroll: true });
          }
        }
      });

      if (
        satellite instanceof HTMLButtonElement &&
        satellite.dataset.bound !== "true"
      ) {
        satellite.dataset.bound = "true";
        satellite.addEventListener("click", () => {
          satellite.classList.remove("is-signaling");
          void satellite.offsetWidth;
          satellite.classList.add("is-signaling");
          latest?.classList.remove("is-located");
          void latest?.getBoundingClientRect();
          latest?.classList.add("is-located");

          if (latest instanceof HTMLElement) {
            const latestTrigger = latest.querySelector(
              "[data-activity-trigger]",
            );
            closeActivitiesExcept(latest);
            setActivityOpen(latest, true);
            if (latestTrigger instanceof HTMLButtonElement) {
              latestTrigger.focus({ preventScroll: true });
            }
            if (window.innerWidth < 768 && !reducedMotion.matches) {
              latest.scrollIntoView({
                block: "nearest",
                behavior: "smooth",
              });
            }
          }
        });
        satellite.addEventListener("animationend", () => {
          satellite.classList.remove("is-signaling");
        });
      }

      const search = document.querySelector("#projects-search");
      window.addEventListener("keydown", (event) => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k" &&
          search instanceof HTMLInputElement
        ) {
          event.preventDefault();
          search.focus();
        }
      });
    })();
  </script>
</BaseLayout>
