---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JourneyGate from "../../components/JourneyGate.astro";
import { documentStatusLabels } from "../../data/labels";

const entries = (await getCollection("docs", ({ data }) => !data.draft))
  .sort((a, b) => {
    const aDate = a.data.updatedAt?.valueOf() ?? a.data.publishedAt.valueOf();
    const bDate = b.data.updatedAt?.valueOf() ?? b.data.publishedAt.valueOf();
    return bDate - aDate;
  });
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
---

<BaseLayout
  title="文档"
  description="持续修订的工作手记、检查清单与技术备忘录。"
  theme="document"
>
  <div class="document-index-world">
    <header class="document-index-hero artifact-destination artifact-destination--document">
      <a href="/" class="document-index-hero__home">← HOME</a>
      <div>
        <h1>持续工作的<br />文档。</h1>
        <p>
          现场笔记、检查清单和技术备忘录。它们持续有用，是因为会随着工作本身一起改变。
        </p>
      </div>
    </header>

    <section class="document-ledger" aria-label="文档集合">
      <ol>
        {
          entries.map((entry) => (
            <li>
              <a class="document-record" href={`/docs/${entry.id}`}>
                <div class="document-record__title">
                  <h2>{entry.data.title}</h2>
                  <p>{entry.data.summary}</p>
                </div>
                <footer>
                  <span>{entry.data.section}</span>
                  <time datetime={(entry.data.updatedAt ?? entry.data.publishedAt).toISOString()}>
                    修订于 {formatDate(entry.data.updatedAt ?? entry.data.publishedAt)}
                  </time>
                  <span>{documentStatusLabels[entry.data.status] ?? entry.data.status}</span>
                </footer>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <JourneyGate
    nextHref="/projects"
    eyebrow="END OF DOCUMENTS"
    title="继续下拉，进入 Projects。"
    linkLabel="Open Projects"
    tone="document-code"
    artifact="repo"
  />
</BaseLayout>
