---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IdeasSingularity from "../../components/IdeasSingularity.astro";
import { listPublishedIdeas } from "../../lib/server/idea-store";

export const prerender = false;

const ideas = listPublishedIdeas();
const formatDate = (date: string) => new Date(date).toISOString().slice(0, 10);
const formatIdeaNumber = (index: number) =>
  String(index + 1).padStart(2, "0");
---

<BaseLayout
  title="灵感"
  description="在它们变成文章、文档或代码之前，先保留那些值得记住的小观察。"
  theme="ochre"
>
  <section class="ideas-signals" aria-labelledby="ideas-title">
    <h1 id="ideas-title" class="ideas-signals__title">灵感</h1>

    <div class="ideas-signals__inner">
      <div class="ideas-navigation-field" aria-hidden="true">
        <svg
          viewBox="0 0 1600 900"
          preserveAspectRatio="none"
          focusable="false"
        >
          <path
            class="ideas-navigation-route ideas-navigation-route--track"
            d="M-40 230C280 216 520 245 760 232S1190 330 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />
          <path
            class="ideas-navigation-route ideas-navigation-route--flow"
            d="M-40 230C280 216 520 245 760 232S1190 330 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />
          <path
            class="ideas-navigation-route ideas-navigation-route--signal"
            d="M-40 230C280 216 520 245 760 232S1190 330 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />

          <path
            class="ideas-navigation-route ideas-navigation-route--track"
            d="M-30 655C300 680 500 630 790 650S1190 440 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />
          <path
            class="ideas-navigation-route ideas-navigation-route--flow ideas-navigation-route--secondary"
            d="M-30 655C300 680 500 630 790 650S1190 440 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />
          <path
            class="ideas-navigation-route ideas-navigation-route--signal ideas-navigation-route--secondary"
            d="M-30 655C300 680 500 630 790 650S1190 440 1420 385"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          />

          <g
            class="ideas-navigation-waypoint"
            transform="translate(680 235)"
          >
            <circle r="4" />
            <path d="M-13 0H-7M7 0H13M0-13V-7M0 7V13" />
          </g>
          <g
            class="ideas-navigation-waypoint ideas-navigation-waypoint--late"
            transform="translate(1150 442)"
          >
            <circle r="4" />
            <path d="M-13 0H-7M7 0H13M0-13V-7M0 7V13" />
          </g>
        </svg>
      </div>

      <IdeasSingularity />

      <div class="ideas-board" id="ideas">
        {
          ideas.length > 0 ? (
            <ol class="signal-card-grid">
              {ideas.map((idea, index) => (
                <li class="signal-card-item">
                  <article class="signal-card" id={idea.sourceKey}>
                    <header class="signal-card__meta">
                      <span class="signal-card__catalog">
                        <span class="signal-card__index" aria-hidden="true">
                          {formatIdeaNumber(index)}
                        </span>
                        <span>{idea.theme}</span>
                      </span>
                      <time datetime={idea.capturedAt}>
                        {formatDate(idea.capturedAt)}
                      </time>
                    </header>
                    <h2>{idea.text}</h2>
                    <a
                      class="signal-card__permalink"
                      href={`#${idea.sourceKey}`}
                      aria-label={`此条灵感的固定链接：${idea.text}`}
                    >
                      <span aria-hidden="true">#</span>
                    </a>
                  </article>
                </li>
              ))}
            </ol>
          ) : (
            <div class="ideas-empty-state" role="status">
              <span aria-hidden="true">∅</span>
              <p>还没有被记录下来的灵感。</p>
              <small>新的观察会从 SQLite 档案中出现在这里。</small>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
