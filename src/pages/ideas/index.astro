---
import IdeasSingularity from "../../components/IdeasSingularity.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  filterIdeas,
  ideaArchiveHref,
  ideaDateKey,
  ideaEmptyMessage,
  listIdeaDates,
  listIdeaThemes,
  normalizeIdeaTheme,
} from "../../lib/idea-archive";
import { normalizeSearch } from "../../lib/archive-query";
import { listPublishedIdeas } from "../../lib/server/idea-store";
import "../../styles/ideas-journal.css";

export const prerender = false;

const allIdeas = listPublishedIdeas();
const query = normalizeSearch(Astro.url.searchParams.get("q"));
const selectedDate = ideaDateKey(Astro.url.searchParams.get("date") ?? "");
const dates = listIdeaDates(allIdeas);
const themes = listIdeaThemes(allIdeas);
const selectedTheme = normalizeIdeaTheme(
  Astro.url.searchParams.get("theme"),
  themes,
);
const ideas = filterIdeas(allIdeas, query, selectedDate, selectedTheme);
const emptyMessage = ideaEmptyMessage({
  query,
  date: selectedDate,
  theme: selectedTheme,
});
const leadingThemes = themes.slice(0, 4);
const activeLongTail =
  selectedTheme &&
  !leadingThemes.some(({ name }) => name === selectedTheme)
    ? themes.find(({ name }) => name === selectedTheme)
    : undefined;
const visibleThemes = activeLongTail
  ? [...leadingThemes, activeLongTail]
  : leadingThemes;
const visibleThemeNames = new Set(visibleThemes.map(({ name }) => name));
const moreThemes = themes.filter(({ name }) => !visibleThemeNames.has(name));
const hrefForTheme = (theme: string) =>
  ideaArchiveHref({ query, date: selectedDate, theme });
const sequenceByKey = new Map(
  allIdeas.map((idea, index) => [idea.sourceKey, index + 1]),
);
const orbitOffsets = [0, 10, 15, 12, 2, -8, -13, -9, 0];
const formatIdeaNumber = (index: number) => String(index).padStart(2, "0");
---

<BaseLayout
  title="灵感"
  description="在它们变成文章、文档或代码之前，先保留那些值得记住的小观察。"
  theme="ochre"
>
  <section
    class="ideas-journal"
    aria-labelledby="ideas-title"
    data-ideas-journal
  >
    <h1 id="ideas-title" class="sr-only">灵感</h1>

    <div class="ideas-journal__backdrop" aria-hidden="true">
      <IdeasSingularity />
    </div>

    <div class="ideas-journal__content">
      <div
        class="ideas-journal__backdrop ideas-journal__top-mask"
        aria-hidden="true"
      >
        <IdeasSingularity />
      </div>

      <form
        class="ideas-journal__search"
        method="get"
        action="/ideas"
        role="search"
        data-ideas-search
      >
        <div class="ideas-journal__query">
          <label class="sr-only" for="ideas-query">搜索灵感或关键词</label>
          <svg class="ideas-journal__search-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.4"></circle>
            <path d="m15.3 15.3 4.6 4.6"></path>
          </svg>
          <input
            id="ideas-query"
            type="search"
            name="q"
            value={query}
            placeholder="搜索灵感或关键词"
            autocomplete="off"
          />
        </div>

        <div class="ideas-journal__filter-controls">
          <input type="hidden" name="theme" value={selectedTheme} />
          <details class="ideas-journal__theme-filter" data-ideas-theme-filter>
            <summary aria-label={`按分类筛选，当前：${selectedTheme || "全部分类"}`}>
              <svg class="ideas-journal__theme-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 5h9l5 5-9 9-5-5z"></path>
                <circle cx="9" cy="9" r="1.2"></circle>
              </svg>
              <span>{selectedTheme || "全部分类"}</span>
              <svg class="ideas-journal__chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </summary>

            <div class="ideas-journal__theme-menu" data-ideas-theme-menu>
              <div role="group" aria-label="选择灵感分类">
                <a
                  class="ideas-journal__theme-option"
                  href={hrefForTheme("")}
                  aria-current={!selectedTheme ? "page" : undefined}
                >
                  <span>全部分类</span>
                  <b>{String(allIdeas.length).padStart(2, "0")}</b>
                </a>
                {
                  themes.map((theme) => (
                    <a
                      class="ideas-journal__theme-option"
                      href={hrefForTheme(theme.name)}
                      aria-current={theme.name === selectedTheme ? "page" : undefined}
                    >
                      <span>{theme.name}</span>
                      <b>{String(theme.count).padStart(2, "0")}</b>
                    </a>
                  ))
                }
              </div>
            </div>
          </details>

          <span class="ideas-journal__filter-divider" aria-hidden="true"></span>

          <input
            type="hidden"
            name="date"
            value={selectedDate}
            data-ideas-date-value
          />
          <details class="ideas-journal__date-filter" data-ideas-date-filter>
            <summary aria-label={`按日期筛选，当前：${selectedDate || "全部日期"}`}>
              <svg class="ideas-journal__calendar-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 7.5h14v12H5z"></path>
                <path d="M8 4.5v5M16 4.5v5M5 11h14"></path>
              </svg>
              <span>{selectedDate || "全部日期"}</span>
              <svg class="ideas-journal__chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </summary>

            <div class="ideas-journal__date-menu">
              <div role="group" aria-label="选择灵感日期">
                <button
                  class="ideas-journal__date-option"
                  type="button"
                  data-ideas-date-option
                  data-date-value=""
                  aria-current={!selectedDate ? "page" : undefined}
                >
                  全部日期
                </button>
                {
                  dates.map((date) => (
                    <button
                      class="ideas-journal__date-option"
                      type="button"
                      data-ideas-date-option
                      data-date-value={date}
                      aria-current={date === selectedDate ? "page" : undefined}
                    >
                      {date}
                    </button>
                  ))
                }
              </div>
            </div>
          </details>
        </div>

        <nav
          class="ideas-journal__theme-index"
          data-ideas-theme-index
          aria-label="按分类筛选灵感"
        >
          <span class="ideas-journal__theme-index-label">分类索引</span>
          <a
            class="ideas-journal__theme-index-option"
            href={hrefForTheme("")}
            aria-current={!selectedTheme ? "page" : undefined}
          >
            <span>全部</span>
            <b>{allIdeas.length}</b>
          </a>
          {
            visibleThemes.map((theme) => (
              <a
                class="ideas-journal__theme-index-option"
                href={hrefForTheme(theme.name)}
                aria-current={theme.name === selectedTheme ? "page" : undefined}
              >
                <span>{theme.name}</span>
                <b>{theme.count}</b>
              </a>
            ))
          }
          {
            moreThemes.length > 0 && (
              <details class="ideas-journal__theme-more" data-ideas-theme-more>
                <summary>
                  <span>更多 {moreThemes.length} 类</span>
                  <svg class="ideas-journal__chevron" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m4 6 4 4 4-4"></path>
                  </svg>
                </summary>
                <div class="ideas-journal__theme-menu ideas-journal__theme-menu--desktop">
                  <div role="group" aria-label="更多灵感分类">
                    {moreThemes.map((theme) => (
                      <a
                        class="ideas-journal__theme-option"
                        href={hrefForTheme(theme.name)}
                        aria-current={theme.name === selectedTheme ? "page" : undefined}
                      >
                        <span>{theme.name}</span>
                        <b>{String(theme.count).padStart(2, "0")}</b>
                      </a>
                    ))}
                  </div>
                </div>
              </details>
            )
          }
        </nav>
        <button class="sr-only" type="submit">筛选灵感</button>
      </form>

      {
        ideas.length > 0 ? (
          <div class="ideas-journal__timeline" data-ideas-timeline>
            <svg
              class="ideas-journal__track"
              aria-hidden="true"
              data-ideas-track
              preserveAspectRatio="none"
            >
              <path class="ideas-journal__track-base" data-ideas-track-base />
              <path
                class="ideas-journal__track-progress"
                data-ideas-track-progress
                pathLength="1"
              />
              <path
                class="ideas-journal__track-cursor"
                d="M 0 -6 L 11 0 L 0 6 Z"
                data-ideas-track-cursor
              />
            </svg>

            <ol class="ideas-journal__entries" aria-label="灵感时间线">
              {ideas.map((idea, index) => (
                <li
                  id={idea.sourceKey}
                  class="ideas-journal__entry"
                  data-idea-entry
                  style={`--orbit-shift:${orbitOffsets[index % orbitOffsets.length]}px`}
                >
                  <article>
                    <header class="ideas-journal__meta">
                      <span>
                        <b aria-hidden="true">
                          {formatIdeaNumber(sequenceByKey.get(idea.sourceKey) ?? index + 1)}
                        </b>
                        <a
                          class="ideas-journal__entry-theme"
                          href={ideaArchiveHref({
                            query,
                            date: selectedDate,
                            theme: idea.theme,
                          })}
                          aria-label={`查看“${idea.theme}”分类的灵感`}
                        >
                          {idea.theme}
                        </a>
                      </span>
                      <time datetime={idea.capturedAt}>
                        {ideaDateKey(idea.capturedAt)}
                      </time>
                    </header>

                    <span
                      class="ideas-journal__node"
                      aria-hidden="true"
                      data-idea-node
                    ></span>

                    <h2>
                      <a href={`#${idea.sourceKey}`}>{idea.text}</a>
                    </h2>
                  </article>
                </li>
              ))}
            </ol>
          </div>
        ) : (
          <div class="ideas-journal__empty" role="status">
            <p>{emptyMessage}</p>
            <a href="/ideas">清空全部筛选</a>
          </div>
        )
      }
    </div>
  </section>

  <script>
    const searchForm = document.querySelector<HTMLFormElement>(
      "[data-ideas-search]",
    );
    const queryInput = document.querySelector<HTMLInputElement>("#ideas-query");
    const dateFilter = document.querySelector<HTMLDetailsElement>(
      "[data-ideas-date-filter]",
    );
    const themeFilter = document.querySelector<HTMLDetailsElement>(
      "[data-ideas-theme-filter]",
    );
    const themeMore = document.querySelector<HTMLDetailsElement>(
      "[data-ideas-theme-more]",
    );
    const disclosures = [dateFilter, themeFilter, themeMore].filter(
      (disclosure): disclosure is HTMLDetailsElement => Boolean(disclosure),
    );
    const dateValue = document.querySelector<HTMLInputElement>(
      "[data-ideas-date-value]",
    );
    const dateOptions = document.querySelectorAll<HTMLButtonElement>(
      "[data-ideas-date-option]",
    );

    dateOptions.forEach((option) => {
      option.addEventListener("click", () => {
        if (!dateValue) return;
        dateValue.value = option.dataset.dateValue ?? "";
        dateFilter?.removeAttribute("open");
        searchForm?.requestSubmit();
      });
    });

    disclosures.forEach((disclosure) => {
      disclosure.addEventListener("toggle", () => {
        if (!disclosure.open) return;
        disclosures.forEach((candidate) => {
          if (candidate !== disclosure) candidate.removeAttribute("open");
        });
      });
    });

    document.addEventListener("pointerdown", (event) => {
      if (!(event.target instanceof Node)) return;
      disclosures.forEach((disclosure) => {
        if (disclosure.open && !disclosure.contains(event.target as Node)) {
          disclosure.removeAttribute("open");
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      const openDisclosure = disclosures.find(({ open }) => open);
      if (event.key === "Escape" && openDisclosure) {
        openDisclosure.removeAttribute("open");
        openDisclosure.querySelector("summary")?.focus();
        return;
      }

      if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "k"
      ) {
        event.preventDefault();
        queryInput?.focus();
      }
    });

    const timeline = document.querySelector<HTMLElement>(
      "[data-ideas-timeline]",
    );

    if (timeline) {
      const track = timeline.querySelector<SVGSVGElement>("[data-ideas-track]");
      const basePath = timeline.querySelector<SVGPathElement>(
        "[data-ideas-track-base]",
      );
      const progressPath = timeline.querySelector<SVGPathElement>(
        "[data-ideas-track-progress]",
      );
      const cursor = timeline.querySelector<SVGPathElement>(
        "[data-ideas-track-cursor]",
      );
      const nodes = [
        ...timeline.querySelectorAll<HTMLElement>("[data-idea-node]"),
      ];
      const entries = [
        ...timeline.querySelectorAll<HTMLElement>("[data-idea-entry]"),
      ];
      let pathLength = 0;
      let updateFrame = 0;
      let resizeFrame = 0;

      const smoothPathThrough = (
        points: Array<{ x: number; y: number }>,
      ): string => {
        if (points.length === 0) return "";
        return points.slice(1).reduce((path, point, index) => {
          const previous = points[index];
          const controlY = (previous.y + point.y) / 2;
          return `${path} C ${previous.x} ${controlY}, ${point.x} ${controlY}, ${point.x} ${point.y}`;
        }, `M ${points[0].x} ${points[0].y}`);
      };

      const updateProgress = () => {
        updateFrame = 0;
        if (!progressPath || !cursor || pathLength <= 0 || nodes.length === 0) {
          return;
        }

        const bounds = timeline.getBoundingClientRect();
        const focusY = window.innerHeight * 0.44;
        const progress = Math.min(
          1,
          Math.max(0, (focusY - bounds.top) / Math.max(bounds.height, 1)),
        );
        progressPath.style.strokeDashoffset = String(1 - progress);

        const cursorPoint = progressPath.getPointAtLength(pathLength * progress);
        cursor.setAttribute(
          "transform",
          `translate(${cursorPoint.x} ${cursorPoint.y})`,
        );

        const nodeDistances = nodes.map((node) => {
          const nodeBounds = node.getBoundingClientRect();
          return nodeBounds.top + nodeBounds.height / 2 - focusY;
        });
        const currentIndex = nodeDistances.reduce(
          (closest, distance, index) =>
            Math.abs(distance) < Math.abs(nodeDistances[closest])
              ? index
              : closest,
          0,
        );

        entries.forEach((entry, index) => {
          if (index === currentIndex) entry.dataset.current = "true";
          else delete entry.dataset.current;

          if (nodeDistances[index] < 0) entry.dataset.past = "true";
          else delete entry.dataset.past;
        });
      };

      const scheduleProgress = () => {
        if (updateFrame) return;
        updateFrame = window.requestAnimationFrame(updateProgress);
      };

      const drawTrack = () => {
        resizeFrame = 0;
        if (!track || !basePath || !progressPath || !cursor || nodes.length === 0) {
          return;
        }

        const timelineBounds = timeline.getBoundingClientRect();
        const width = timeline.clientWidth;
        const height = timeline.scrollHeight;
        const measuredPoints = nodes.map((node) => {
          const nodeBounds = node.getBoundingClientRect();
          return {
            x: nodeBounds.left + nodeBounds.width / 2 - timelineBounds.left,
            y: nodeBounds.top + nodeBounds.height / 2 - timelineBounds.top,
          };
        });
        const first = measuredPoints[0];
        const last = measuredPoints.at(-1) ?? first;
        const points = [
          { x: first.x - 10, y: 0 },
          ...measuredPoints,
          { x: last.x + 10, y: height },
        ];
        const pathData = smoothPathThrough(points);

        track.setAttribute("viewBox", `0 0 ${width} ${height}`);
        track.setAttribute("width", String(width));
        track.setAttribute("height", String(height));
        basePath.setAttribute("d", pathData);
        progressPath.setAttribute("d", pathData);
        pathLength = progressPath.getTotalLength();
        updateProgress();
      };

      const scheduleTrack = () => {
        if (resizeFrame) return;
        resizeFrame = window.requestAnimationFrame(drawTrack);
      };

      const observer = new ResizeObserver(scheduleTrack);
      observer.observe(timeline);
      nodes.forEach((node) => observer.observe(node.closest("li") ?? node));
      window.addEventListener("scroll", scheduleProgress, { passive: true });
      window.addEventListener("resize", scheduleTrack);
      document.fonts?.ready.then(scheduleTrack);
      scheduleTrack();

      window.addEventListener(
        "pagehide",
        (event) => {
          if (event.persisted) return;
          observer.disconnect();
          window.removeEventListener("scroll", scheduleProgress);
          window.removeEventListener("resize", scheduleTrack);
          if (updateFrame) window.cancelAnimationFrame(updateFrame);
          if (resizeFrame) window.cancelAnimationFrame(resizeFrame);
        },
        { once: true },
      );
    }
  </script>
</BaseLayout>
